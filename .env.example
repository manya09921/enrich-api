# Copy this file to .env and fill in real values. .env is git-ignored;
# this file (.env.example) is committed so a stranger knows what to set.

# Ollama (local, default in this project):
#   LLM_BASE_URL=http://localhost:11434/v1/
#   LLM_API_KEY=ollama          <- literal string, required but ignored by Ollama
#   LLM_MODEL=gemma3:1b

# OpenRouter (hosted, alternative):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=<your real OpenRouter key>
#   LLM_MODEL=openrouter/free

LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=gemma3:1b

# Skip the model entirely and return a fixed stub response (build/dev mode)
LLM_STUB=0

# Kill switch: set to false to disable the model call and get a clean 503
LLM_ENABLED=true
